*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ─────────────────────────────────────────────────────────────
# Dados — NUNCA versionar imagens médicas ou datasets brutos.
# O conteúdo fica local; só a estrutura de pastas vai pro Git.
# ─────────────────────────────────────────────────────────────
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md

# Extensões de dados/imagens médicas em qualquer lugar do repo
*.dcm
*.dicom
*.nii
*.nii.gz
*.mha
*.mhd
*.raw
*.npy
*.npz
*.tfrecord
*.parquet
*.feather
*.h5
*.hdf5

# ─────────────────────────────────────────────────────────────
# Modelos e artefatos de treino (usar MLflow/DVC/Releases)
# ─────────────────────────────────────────────────────────────
models/**
!models/**/
!models/**/.gitkeep
!models/**/README.md
*.pt
*.pth
*.ckpt
*.onnx
*.pb
*.tflite
*.pkl
*.joblib
*.safetensors

# ─────────────────────────────────────────────────────────────
# Saídas de experimentos / MLOps
# ─────────────────────────────────────────────────────────────
mlruns/
mlartifacts/
wandb/
lightning_logs/
runs/
outputs/
checkpoints/
logs/
*.log
.dvc/cache/
.dvc/tmp/
catboost_info/

# Figuras geradas automaticamente (o relatório final vai como anexo/PR)
reports/figures/**
!reports/figures/.gitkeep

# ─────────────────────────────────────────────────────────────
# Segredos e credenciais — jamais commitar
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml
kaggle.json
.kaggle/
credentials.json
service-account*.json


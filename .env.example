# Copie para .env e preencha. O arquivo .env NÃO vai para o Git.
# cp .env.example .env

# Raiz onde os DICOMs do RSNA foram baixados (fora do repositório)
DATA_ROOT=./data

# Credenciais da API do Kaggle (https://www.kaggle.com/settings -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Rastreamento de experimentos
MLFLOW_TRACKING_URI=./mlruns

# Semente global para reprodutibilidade
RANDOM_SEED=42
